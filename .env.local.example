# Supabase — create a free project at https://supabase.com and paste in values below
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access — comma-separated emails allowed into /admin (the manual RMB
# review queue). Must match an email that has a real account in this app.
ADMIN_EMAILS=

# Klasha — GHS deposit collection only (initiateKlashaDeposit). NGN moved to Busha once it was
# confirmed working live there, while Klasha's own account access stayed blocked (403) the
# entire time this was built. Klasha's CNY payout API was also investigated but confirmed by
# their own team to be merchant-only (pay Klasha's own vendors from their dashboard, not
# resellable to end customers via API) — removed. See src/lib/klasha/client.ts.
KLASHA_API_KEY=
KLASHA_API_BASE_URL=https://gate.klasapps.com
KLASHA_PUBLIC_KEY=

# Klasha request-body encryption secret — 3DES-CBC, must be exactly 24 bytes (see
# src/lib/klasha/client.ts's encryptBody()). From Klasha Dashboard > Settings.
KLASHA_ENCRYPTION_SECRET=

# The value entered into the Klasha dashboard's webhook config "Enter your webhook key" field —
# not documented publicly anywhere, so not yet used by any code. src/app/api/webhooks/klasha/
# route.ts currently logs every incoming header + raw body to webhook_events so the real
# verification scheme (signature header name, algorithm) can be reverse-engineered from the
# first real webhook, using whatever value this was set to.
KLASHA_WEBHOOK_KEY=

# Public URL of this app, used as the redirect target after a Klasha GHS deposit (Klasha's
# hosted payment page sends the customer back here when they're done). Must be a real HTTPS
# URL once deployed — localhost only works for local testing where Klasha can still reach it.
# No NEXT_PUBLIC_ prefix — this is only ever read server-side (src/lib/actions/klasha.ts),
# so it doesn't need to (and shouldn't) ship into the client bundle.
APP_URL=http://localhost:3000

# Busha — deposit + swap API for NGN, KES, and USDT (docs.busha.io) — confirmed live on all
# three; GHS is rejected outright by this account ("Invalid Currency GHS") so GHS deposits go
# through Klasha instead (see above). Use the SECRET key from your Busha dashboard, not the
# public one (the public key is client-side only and will be rejected by these server-side
# calls). Confirmed live only against the production host below — the documented sandbox host
# (api.sandbox.busha.so) rejected a real Busha Business account's secret key entirely, so a
# real registered business account may only work against production.
BUSHA_API_KEY=
BUSHA_API_BASE_URL=https://api.busha.io

# Busha webhook shared secret — NOT currently used to reject anything (see
# src/app/api/webhooks/busha/route.ts's header comment: an earlier version checked a guessed
# header name here, which silently rejected every real webhook — that's very likely why
# deposits never credited). Every delivery is now logged unconditionally, headers included, so
# the real header name/scheme can be read off the first real webhook once one lands.
BUSHA_WEBHOOK_SECRET=

# Shared secret for the deposit-reconciliation cron job (src/app/api/cron/reconcile-deposits) —
# checked against the Authorization header Vercel Cron sends. Set this in Vercel's project env
# vars (Settings > Environment Variables) so the endpoint can't be triggered by anyone who finds
# the URL. Leaving it unset allows any caller through — fine for local testing, not for
# production.
CRON_SECRET=
