# Supabase — create a free project at https://supabase.com and paste in values below
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access — comma-separated emails allowed into /admin (the manual RMB
# review queue). Must match an email that has a real account in this app.
ADMIN_EMAILS=

# Klasha — RMB transfers are OTC-only (no automated API), see supabase/migrations/
# 0004_rmb_manual_transaction_functions.sql. Keep these for future automated
# products Klasha may add (e.g. card issuance), leave blank for now.
KLASHA_API_KEY=
KLASHA_API_BASE_URL=https://sandbox.klasha.com

# Quidax — swap API (NGN/GHS <-> USDT), used for the Exchange USDT flow. Base URL only
# needs overriding if Quidax gives you a distinct sandbox host — defaults to their
# production open API host in src/lib/quidax/client.ts.
QUIDAX_API_KEY=
QUIDAX_API_BASE_URL=

# Quidax — separate ramp/purchase API (different base URL + auth header), used only for
# the deposit price preview (src/lib/quidax/client.ts's getPurchaseQuote). Actual deposit
# collection isn't wired up yet — see that file's header comment.
QUIDAX_RAMP_PRIVATE_KEY=

# Quidax webhook signature secret — the exact header/algorithm Quidax uses isn't confirmed
# from their docs yet (see src/app/api/webhooks/quidax/route.ts); set this once confirmed
# from the dashboard. Leaving it blank allows webhooks through unverified for now.
QUIDAX_WEBHOOK_SECRET=
